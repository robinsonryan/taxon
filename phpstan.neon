includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
    level: 8
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            # Consumer-facing trait (apps `use CanScopeTags`); never used inside src.
            identifier: trait.unused
            path: src/Concerns/CanScopeTags.php
